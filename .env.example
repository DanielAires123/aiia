# Copia este ficheiro para .env e preenche. O .env nunca deve ser partilhado.
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
# Palavra-passe GLOBAL (vê todos os grupos; opção "Todos os grupos" no painel)
ADMIN_PASSWORD=muda-isto
# Palavra-passe do painel de cada mentor: ADMIN_PASSWORD_<NOME_DO_GRUPO>
ADMIN_PASSWORD_GRUPO_I=muda-isto
ADMIN_PASSWORD_GRUPO_II=muda-isto
ADMIN_PASSWORD_GRUPO_III=muda-isto
ADMIN_PASSWORD_GRUPO_IV=muda-isto
ADMIN_PASSWORD_GRUPO_V=muda-isto
# Código de convite opcional que o grupo tem de introduzir no 1.º ecrã
INVITE_CODE=
# Número de perguntas (incluindo a primeira, sobre a área de trabalho)
MAX_QUESTIONS=7
PORT=3000

# Põe 1 quando a app estiver atrás de um proxy/CDN (Cloudflare, Caddy, Render...)
TRUST_PROXY=0

# Supabase: sem estas duas variáveis as respostas ficam em data/responses.json (só para desenvolvimento)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Modelos por ordem de preferência (alternativa automática quando um atinge o limite)
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b

# Lista de grupos/pessoas em JSON numa linha (alternativa ao ficheiro data/roster.json, que não vai para o git)
ROSTER_JSON={"groups":[{"name":"Grupo A","mentor":"Mentor","members":["Pessoa 1","Pessoa 2"]}]}
# Nome da empresa no contexto da IA (opcional)
COMPANY_NAME=
